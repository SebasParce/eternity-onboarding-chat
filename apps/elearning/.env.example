# Cliente (navegador) — seguros de exponer, RLS es lo que protege los datos.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor (API routes) — NUNCA con prefijo NEXT_PUBLIC_, nunca al bundle
# del cliente. Se usa exclusivamente para: (1) vincular auth_user_id la primera
# vez que un creador inicia sesión, y (2) reglas de negocio de módulos
# (desbloqueo secuencial, ventana de acceso) que un creador no debe poder
# manipular directamente vía la anon key.
SUPABASE_SERVICE_ROLE_KEY=

# Horas que dura la ventana de acceso a cada módulo una vez desbloqueado.
MODULE_ACCESS_WINDOW_HOURS=48
