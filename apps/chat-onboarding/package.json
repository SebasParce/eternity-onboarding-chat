{
  "name": "eternity-onboarding-chat",
  "version": "0.1.0",
  "description": "Motor de onboarding conversacional (WhatsApp) para Eternity Agency LATAM — Fase 1",
  "private": true,
  "type": "module",
  "main": "dist/webhook/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/webhook/server.ts",
    "start": "node dist/webhook/server.js",
    "simulate": "tsx scripts/simulate-conversation.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eternity/shared-types": "^0.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
