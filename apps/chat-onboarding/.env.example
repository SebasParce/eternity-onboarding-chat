# --- Supabase (estado compartido del creador) ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# La service role key es necesaria porque el webhook escribe estado desde el backend,
# sin sesión de usuario. Nunca exponer esta key al cliente/frontend.

# --- Canal de WhatsApp Business API ---
# Selecciona el adapter real cuando haya credenciales. Mientras tanto, "mock" simula
# el envío por consola y permite probar el flujo completo sin proveedor.
WHATSAPP_ADAPTER=mock   # mock | twilio | 360dialog | gupshup

# Twilio (si WHATSAPP_ADAPTER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# 360dialog (si WHATSAPP_ADAPTER=360dialog)
DIALOG360_API_KEY=
DIALOG360_BASE_URL=https://waba.360dialog.io

# Gupshup (si WHATSAPP_ADAPTER=gupshup)
GUPSHUP_API_KEY=
GUPSHUP_SOURCE_NUMBER=
GUPSHUP_APP_NAME=

# --- Servidor del webhook ---
PORT=3000
# Token simple para validar que el request al webhook viene del proveedor (o de Meta,
# según el BSP). Cada proveedor tiene su propio esquema real de verificación (ver README).
WEBHOOK_VERIFY_TOKEN=cambia-esto-por-un-secreto

# --- Dashboard interno (/dashboard) ---
# Visor de solo lectura para que un manager vea los creadores registrados y sus
# conversaciones. Protegido con Basic Auth simple (una sola credencial compartida).
# Sin estas dos variables, el dashboard responde 503 en vez de quedar abierto.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
